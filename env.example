# VitalSync AI - local frontend configuration template
# Copy this file to .env.local and adjust values for your machine.
# Do not put private credentials or unrestricted secrets in VITE_* variables.

# FastAPI backend base URL for local development
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Docker/PostgreSQL development configuration. Replace these values before any
# shared or internet-facing deployment. Docker Compose reads them from `.env`.
POSTGRES_DB=vitalsync
POSTGRES_USER=vitalsync
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Native Ollama on macOS, reached from the backend Docker container.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=vitalsync-medquad-qwen3-4b
OLLAMA_TIMEOUT_SECONDS=120

# If the hospital service reads a Geoapify key from Vite environment variables,
# add the exact variable name used in src/services/hospitalService.js below.
# Example only - confirm the variable name in the source before enabling:
# VITE_GEOAPIFY_API_KEY=YOUR_RESTRICTED_GEOAPIFY_KEY
